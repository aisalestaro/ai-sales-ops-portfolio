{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__claude-in-chrome__switch_browser|AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/browser_guard.py", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/git_autocommit.py --trigger stop", "timeout": 90,
            "statusMessage": "未コミット変更を自動コミット中" }
        ]
      }
    ]
  }
}
